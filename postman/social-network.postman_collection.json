{
  "info": {
    "name": "Social Network — Homework 1",
    "description": "Регистрация, вход и публичная анкета. Два раздела по три запроса: ручная проверка без скриптов сохранения переменных и автоматическое сохранение user_id/token для подстановки в следующие запросы. Запросы каждого раздела выполняются по порядку; токен пока не используется запросами.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8880",
      "type": "string"
    },
    {
      "key": "password",
      "value": "ExamplePassword123!",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Ручная проверка",
      "description": "Регистрация → вход → анкета. ID переносится из ответа вручную в Body входа и URL анкеты. Переменные Postman не сохраняются запросами. base_url и password читаются из настроек коллекции/окружения.",
      "item": [
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/user/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Иван\",\n  \"second_name\": \"Иванов\",\n  \"birthdate\": \"1995-05-20\",\n  \"gender\": \"MALE\",\n  \"biography\": \"Java, музыка\",\n  \"city\": \"Москва\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Выполните регистрацию и скопируйте user_id из ответа. Этот запрос не сохраняет переменные Postman."
          },
          "response": []
        },
        {
          "name": "Вход",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"1\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "В Body замените пример id \"1\" на user_id из ручной регистрации. Токен доступен в ответе; переменные Postman не сохраняются."
          },
          "response": []
        },
        {
          "name": "Публичная анкета",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/user/get/1",
            "auth": {
              "type": "noauth"
            },
            "description": "Замените конечный /1 в URL на user_id из ручной регистрации. Анкета публична, токен не требуется; переменные Postman не сохраняются."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 — Автоматическая подстановка переменных",
      "description": "Регистрация → вход → анкета. Скрипты после ответа сохраняют user_id и token в переменные коллекции и окружения. Для Collection Runner/Newman выбирайте эту папку.",
      "item": [
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/user/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Иван\",\n  \"second_name\": \"Иванов\",\n  \"birthdate\": \"1995-05-20\",\n  \"gender\": \"MALE\",\n  \"biography\": \"Java, музыка\",\n  \"city\": \"Москва\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Регистрация: 200 и строковый ID\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user_id).to.be.a(\"string\").and.match(/^[1-9][0-9]*$/);",
                  "  pm.expect(body).not.to.have.property(\"token\");",
                  "  pm.collectionVariables.set(\"user_id\", body.user_id);",
                  "  pm.environment.set(\"user_id\", body.user_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{user_id}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Вход: UUIDv4\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const token = pm.response.json().token;",
                  "  pm.expect(token).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);",
                  "  pm.collectionVariables.set(\"token\", token);",
                  "  pm.environment.set(\"token\", token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Публичная анкета",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/user/get/{{user_id}}",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Публичная анкета без Bearer: 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.variables.get(\"user_id\"));",
                  "  pm.expect(body.first_name).to.eql(\"Иван\");",
                  "  pm.expect(body.second_name).to.eql(\"Иванов\");",
                  "  pm.expect(body.gender).to.eql(\"MALE\");",
                  "  pm.expect(body).not.to.have.property(\"password\");",
                  "  pm.expect(body).not.to.have.property(\"password_hash\");",
                  "  pm.expect(body).not.to.have.property(\"token_hash\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
